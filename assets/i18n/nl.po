#: src/ui/settings.rs:2373
msgid "Try fewer words, or check the spelling."
msgstr "Probeer minder woorden of controleer de spelling."

#: src/ui/settings.rs:2394
msgctxt "start with your computer"
msgid "Off"
msgstr "Uit"

#: src/ui/settings.rs:2395
