msgstr "Er wordt geen proxy gebruikt."

#: src/ui/settings.rs:1699
msgid "Using the system proxy."
msgstr "De systeemproxy wordt gebruikt."

#: src/ui/settings.rs:1710
msgid "Winamp skins"
msgstr "Winamp-skins"

#: src/ui/settings.rs:1711 src/ui/winamp/mod.rs:724 src/ui/winamp/mod.rs:871
msgid "Always on top"
msgstr "Altijd bovenop"

#: src/ui/settings.rs:1712
msgid "Show Winamp in taskbar"
msgstr "Winamp in taakbalk tonen"

#: src/ui/settings.rs:1715
msgid "Mini player"
msgstr "Minispeler"

#: src/ui/settings.rs:1719
msgid ""
"Use classic Winamp .wsz skins. Press Ctrl+M or click the skin logo to "
"return. Drop a skin on either window to add it."
msgstr ""
"Gebruik klassieke Winamp-skins (.wsz). Druk op Ctrl+M of klik op het "
"skinlogo om terug te gaan. Sleep een skin naar een van beide vensters om hem "
"toe te voegen."

#: src/ui/settings.rs:1723
msgid ""
"Use classic Winamp .wsz skins. Press Cmd+Shift+M or click the skin logo to "
"return. Drop a skin on either window to add it."
msgstr ""
"Gebruik klassieke Winamp-skins (.wsz). Druk op Cmd+Shift+M of klik op het "
"skinlogo om terug te gaan. Sleep een skin naar een van beide vensters om hem "
"toe te voegen."

#: src/ui/settings.rs:1729
msgid "Skin"
msgstr "Skin"

#. Translators: {folder} is the path of the skins folder.
#: src/ui/settings.rs:1733
#, rust-format
msgid "Installed skins are in {folder}. Find more at the Winamp Skin Museum."
msgstr ""
"Geïnstalleerde skins staan in {folder}. Vind er meer in het Winamp Skin "
"Museum."

#: src/ui/settings.rs:1738 src/ui/winamp/mod.rs:711
msgid "Size"
msgstr "Grootte"

#: src/ui/settings.rs:1739
msgid "Whole-number scaling keeps skin pixels sharp."
msgstr "Schalen met hele getallen houdt de skinpixels scherp."

#: src/ui/settings.rs:1744
msgid "Keep the Winamp window above everything else."
msgstr "Het Winamp-venster boven alle andere houden."

#: src/ui/settings.rs:1750 src/ui/winamp/mod.rs:734
msgid "Show in taskbar"
msgstr "Tonen in taakbalk"

#: src/ui/settings.rs:1753
msgid ""
"Keep a taskbar button for the mini player. The tray icon stays available "
"when hidden."
msgstr ""
"Houd een taakbalkknop voor de minispeler. Het pictogram in het systeemvak "
"blijft beschikbaar als die verborgen is."

#: src/ui/settings.rs:1758
msgid "Installed skins"
msgstr "Geïnstalleerde skins"

#: src/ui/settings.rs:1771
msgid "Switch to it"
msgstr "Overschakelen"

#: src/ui/settings.rs:1784
msgid "Skin Museum"
msgstr "Skin Museum"

#: src/ui/settings.rs:1810
msgid "Random"
msgstr "Willekeurig"

